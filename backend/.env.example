PORT=5001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5001
CORS_ORIGINS=http://localhost:5173,https://dholkinights.netlify.app
MONGODB_URI=your_mongodb_connection_string
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# --------------------------------------------------------------------------
# PhonePe Payment Gateway (Official Standard Hosted Checkout)
# --------------------------------------------------------------------------
# PhonePe Environment: "SANDBOX" for testing, "PRODUCTION" for live transactions
PHONEPE_ENV=SANDBOX

# PhonePe Merchant ID provided in your PhonePe merchant dashboard
# (For sandbox test, PGTESTPAYUAT86 is supported)
PHONEPE_MERCHANT_ID=PGTESTPAYUAT86

# PhonePe Salt Key / Secret provided in your PhonePe dashboard
PHONEPE_SALT_KEY=96434309-7796-489d-8924-ab56988a6076

# PhonePe Salt Index (typically 1)
PHONEPE_SALT_INDEX=1

# Optional custom override for PhonePe host URL (defaults based on PHONEPE_ENV)
# Production: https://api.phonepe.com/apis/hermes
# Sandbox: https://api-preprod.phonepe.com/apis/pg-sandbox
# PHONEPE_HOST_URL=https://api-preprod.phonepe.com/apis/pg-sandbox

# PhonePe S2S Webhook / Callback URL to configure in PhonePe Merchant Dashboard:
# Local dev: http://localhost:5001/api/payments/phonepe/webhook
# Render Prod: https://garba-nights-dewas.onrender.com/api/payments/phonepe/webhook
PHONEPE_CALLBACK_URL=http://localhost:5001/api/payments/phonepe/webhook

# --------------------------------------------------------------------------
# Razorpay (Optional / Legacy Backup)
# --------------------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=